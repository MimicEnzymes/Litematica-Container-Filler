{
  "schemaVersion": 1,
  "id": "litematica_container_filler",
  "version": "0.10.4",
  "name": "Litematica Container Filler",
  "description": "Auto-fill containers from Litematica schematics with material lists, highlights, and configurable filling helpers.",
  "authors": ["MimicEnzymes"],
  "contact": {
    "homepage": "https://modrinth.com/mod/litematica-container-filler",
    "sources": "https://github.com/MimicEnzymes/Litematica-Container-Filler",
    "issues": "https://github.com/MimicEnzymes/Litematica-Container-Filler/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/litematica_container_filler/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.mimicenzymes.litematicafiller.LitematicafillerClient"
    ],
    "modmenu": [
      "com.mimicenzymes.litematicafiller.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "litematica_container_filler.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3 <26.4",
    "java": ">=25",
    "fabric-api": "*",
    "malilib": "*",
    "litematica": "*"
  },
  "suggests": {
    "quickshulker": "*",
    "modmenu": "*"
  }
}

